# DuckDB database / DuckDB 데이터베이스
# cp config/duckdb.env.example config/duckdb.env
#
# DuckDB has no server: the database is one file, created on first use.
# DuckDB 는 서버가 없습니다. 데이터베이스는 파일 하나이며 처음 사용할 때 생성됩니다.

# Path of the database file. Relative paths are relative to where you run the command;
# the default (unset) is <repo>/.data/tpcds.duckdb, which is git-ignored.
# 데이터베이스 파일 경로. 상대 경로는 명령을 실행한 위치 기준이며, 미설정 시 기본값은
# <repo>/.data/tpcds.duckdb 입니다(git 제외).
DUCKDB_DATABASE=.data/tpcds.duckdb

# Optional — leave commented out to use DuckDB's defaults (all cores, 80% of RAM).
# 선택 — 주석 상태면 DuckDB 기본값(전체 코어, RAM 의 80%)을 사용합니다.
#DUCKDB_THREADS=8
#DUCKDB_MEMORY_LIMIT=16GB
