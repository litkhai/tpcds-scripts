# ClickHouse connection / ClickHouse 접속 설정
# cp config/clickhouse.env.example config/clickhouse.env

CH_HOST=localhost
CH_PORT=9000
CH_USER=default
CH_PASSWORD=
CH_DATABASE=tpcds

# Settings required by the upstream query set / 상류 쿼리 세트가 요구하는 설정
#
# These are not optional tuning knobs. They are the settings the ClickHouse project
# runs its own TPC-DS benchmark with, preserved verbatim in
# engines/clickhouse/reference/upstream-settings.json. Without them:
# 이들은 선택적 튜닝 옵션이 아닙니다. ClickHouse 프로젝트가 자체 TPC-DS 벤치마크를
# 실행할 때 사용하는 설정이며 engines/clickhouse/reference/upstream-settings.json 에
# 원문 그대로 보존되어 있습니다. 이 설정이 없으면:
#
#   union_default_mode=DISTINCT           q49 and q75 fail: "Expected ALL or DISTINCT
#                                         in SelectWithUnion query"
#                                         q49·q75 실패
#   joined_subquery_requires_alias=0      q14_1 and q14_2 fail: "no alias for subquery
#                                         or table function"
#                                         q14_1·q14_2 실패
#   intersect_default_mode=DISTINCT       the INTERSECT in q14 needs an explicit mode
#                                         q14 의 INTERSECT 에 명시적 모드가 필요
#   join_use_nulls=1                      outer joins must produce NULL, not the type
#   group_by_use_nulls=1                  default, or ROLLUP and GROUPING() give wrong
#   data_type_default_nullable=1          answers rather than an error
#                                         외부 조인과 ROLLUP·GROUPING() 이 타입 기본값
#                                         대신 NULL 을 생성해야 하며, 그렇지 않으면
#                                         오류 없이 잘못된 답을 반환
#
# The last three change results silently rather than failing, which makes them the
# more important ones to keep.
# 마지막 세 개는 실패 없이 결과를 조용히 바꾸므로 더 중요하게 유지해야 합니다.
CH_EXTRA_ARGS='--union_default_mode=DISTINCT --intersect_default_mode=DISTINCT --joined_subquery_requires_alias=0 --join_use_nulls=1 --group_by_use_nulls=1 --data_type_default_nullable=1'

# Run OPTIMIZE TABLE ... FINAL after loading (1) or skip it (0)
# 적재 후 OPTIMIZE TABLE ... FINAL 실행(1) 또는 생략(0)
CH_OPTIMIZE_AFTER_LOAD=1
