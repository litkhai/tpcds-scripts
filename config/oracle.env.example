# Oracle connection / Oracle 접속 설정
# cp config/oracle.env.example config/oracle.env  (config/*.env is git-ignored / git 제외)

# EZConnect or a tnsnames alias / EZConnect 또는 tnsnames 별칭
ORACLE_CONNECT='tpcds/tpcds@//localhost:1521/FREEPDB1'

# Schema that owns the tables — used only for reporting / 테이블 소유 스키마(보고용)
ORACLE_SCHEMA=tpcds

# sqlldr options. direct=true bypasses the buffer cache; drop it if the target
# table has enabled constraints or triggers.
# sqlldr 옵션. direct=true 는 버퍼 캐시를 우회합니다. 대상 테이블에 활성 제약이나
# 트리거가 있으면 제거하십시오.
ORACLE_SQLLDR_OPTS='direct=true parallel=true rows=100000 errors=0'
