# ClickHouse connection / ClickHouse 접속 설정
# cp config/clickhouse.env.example config/clickhouse.env

CH_HOST=localhost
CH_PORT=9000
CH_USER=default
CH_PASSWORD=
CH_DATABASE=tpcds

# Extra clickhouse-client flags, e.g. --secure for ClickHouse Cloud
# 추가 clickhouse-client 플래그. 예: ClickHouse Cloud 는 --secure
CH_EXTRA_ARGS=''

# Run OPTIMIZE TABLE ... FINAL after loading (1) or skip it (0)
# 적재 후 OPTIMIZE TABLE ... FINAL 실행(1) 또는 생략(0)
CH_OPTIMIZE_AFTER_LOAD=1
